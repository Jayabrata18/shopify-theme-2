<script>
  document.addEventListener('DOMContentLoaded', function () {
    let cookiePolicyExpandedSection = null;

    function cookiePolicyToggleSection(index) {
      if (cookiePolicyExpandedSection === index) {
        cookiePolicyExpandedSection = null;
      } else {
        cookiePolicyExpandedSection = index;
      }

      // Update all sections
      document.querySelectorAll('.cookie-policy-type-details').forEach((details, i) => {
        details.style.display = i === cookiePolicyExpandedSection ? 'block' : 'none';
      });

      document.querySelectorAll('.cookie-policy-type-toggle').forEach((toggle, i) => {
        toggle.textContent = i === cookiePolicyExpandedSection ? '❌' : '⚙️';
      });
    }

    // Make function globally available
    window.cookiePolicyToggleSection = cookiePolicyToggleSection;
  });
</script>

