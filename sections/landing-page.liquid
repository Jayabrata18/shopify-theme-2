<!--
  ═══════════════════════════════════════════════════
       VIDEO HERO
  ═══════════════════════════════════════════════════
-->
<section class="lp-hero" id="lp-hero">
  <div class="lp-hero__video-wrap">
    <video muted loop playsinline preload="auto" class="lp-hero__video" id="lp-hero-video">
      <source src="https://cdn.shopify.com/videos/c/o/v/7675e1f01f07408b893a3691d38f087b.mp4" type="video/mp4">
    </video>
    <div class="lp-hero__overlay"></div>
  </div>

  <div class="lp-hero__content">
    <h1 class="lp-hero__heading">It's Only You Against You</h1>
  </div>

  {% comment %}
    <div class="lp-hero__scroll-hint">
      <span class="lp-hero__scroll-line"></span>
      <span class="lp-hero__scroll-label">Scroll</span>
    </div>
  {% endcomment %}
</section>

<!--
  ═══════════════════════════════════════════════════
       COLLECTION 1
  ═══════════════════════════════════════════════════
-->
{%- assign lp_col_count = 0 -%}

{%- for collection in collections -%}
  {%- unless collection.handle == 'all' or collection.products_count == 0 -%}
    {%- assign lp_col_count = lp_col_count | plus: 1 -%}

    <section class="lp-collection lp-reveal" id="lp-collection-{{ lp_col_count }}">
      <div class="lp-container">
        <div class="lp-collection__head">
          <h2 class="lp-collection__title">{{ collection.title }}</h2>
          {% comment %}
            <a href="{{ collection.url }}" class="lp-collection__see-more">
              See More
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          {% endcomment %}
        </div>
        <div class="lp-collection__grid">
          {%- for product in collection.products limit: 4 -%}
            {%- render 'card-product-urbnmyth', product: product -%}
          {%- endfor -%}
        </div>
        <div class="lp-collection__footer">
          <a href="{{ collection.url }}" class="lp-collection__see-more-btn">
            See More
          </a>
        </div>
      </div>
    </section>

    <!--
      ─────────────────────────────────────────────
           COMMUNITY SECTION (after 1st collection)
      ─────────────────────────────────────────────
    -->
    {%- if lp_col_count == 1 -%}
      <section class="lp-community lp-reveal" id="lp-community">
        <div class="lp-community__bg">
          <picture>
            <source
              media="(max-width: 900px)"
              srcset="https://cdn.shopify.com/s/files/1/0782/0689/4322/files/Coming_Soon_Mobile.jpg?v=1782929680"
            >
            <img
              src="https://cdn.shopify.com/s/files/1/0782/0689/4322/files/Coming_Soon_1.jpg?v=1782930471"
              alt="Coming Soon"
              class="lp-community__img"
              width="2000"
              height="1125"
              loading="lazy"
            >
          </picture>
        </div>
        <div class="lp-community__fog-left"></div>
        <div class="lp-community__dark-right"></div>
        <div class="lp-community__layout">
          <div class="lp-community__left"></div>
          <div class="lp-community__right">
            <div class="lp-community__content">
              <p class="lp-community__cs-eyebrow lp-fade-up">What's Next</p>
              <h2 class="lp-community__cs-heading" data-lp-split>Coming Soon</h2>
              <p class="lp-community__eyebrow lp-fade-up">Stay updated on upcoming designs</p>
              <h2 class="lp-community__heading" data-lp-split>Join Us On WhatsApp</h2>
              <a href="#" class="lp-community__btn lp-fade-up" target="_blank" rel="noopener">
                <svg class="lp-community__btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Join the Community
              </a>
            </div>
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if lp_col_count >= 2 -%}{%- break -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}

<!--
  ═══════════════════════════════════════════════════
       FOOTER IMAGE
  ═══════════════════════════════════════════════════
-->
{% comment %}
  <div class="lp-footer-img lp-reveal" id="lp-footer-img">
    <img
      src="https://cdn.shopify.com/s/files/1/0782/0689/4322/files/hf_20260629_063024_d6a0d67b-3d6a-4d3a-aa22-9f5586bd2dcc.png?v=1782837020"
      alt="URBNMYTH"
      class="lp-footer-img__img"
      width="2000"
      height="1125"
      loading="lazy"
    >
  </div>
{% endcomment %}

{%- render 'urbnmyth-product-card-styles' -%}

<!--
  ═══════════════════════════════════════════════════
       STYLES
  ═══════════════════════════════════════════════════
-->
<style>
  .lp-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Scroll Reveal ── */
  .lp-reveal {
    opacity: 0;
    transform: translateY(44px);
    transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lp-reveal.lp-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ── Hero ── */
  .lp-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 580px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lp-hero__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .lp-hero__video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78vh);
    height: max(100%, 56.25vw);
    transform: translate(-50%, -50%);
    object-fit: cover;
    pointer-events: none;
  }
  .lp-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.35) 50%, rgba(0, 0, 0, 0.75) 100%);
  }
  .lp-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 0 24px;
    max-width: 960px;
  }
  .lp-hero__heading {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: clamp(3rem, 10vw, 8.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
    color: #fff;
  }
  .lp-hero__scroll-hint {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .lp-hero__scroll-line {
    display: block;
    width: 1px;
    height: 52px;
    background: rgba(255, 255, 255, 0.35);
    animation: lpScrollPulse 1.9s ease-in-out infinite;
  }
  .lp-hero__scroll-label {
    font-family: 'CoolveticaRg', sans-serif !important;
  }
  @keyframes lpScrollPulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(0.55);
    }
  }

  /* ── Collections ── */
  .lp-collection {
    background: #fff;
    padding: 52px 0;
    border-top: 1px solid #f0f0f0;
  }
  .lp-collection:first-of-type {
    border-top: none;
    padding-top: 44px;
  }
  .lp-collection__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
  }
  .lp-collection__title {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111;
    margin: 0;
    line-height: 1;
  }
  .lp-collection__see-more {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid #111;
    padding-bottom: 1px;
    transition: opacity 0.2s;
  }
  .lp-collection__see-more:hover {
    opacity: 0.5;
  }
  .lp-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .lp-collection__footer {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }
  .lp-collection__see-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #111;
    text-decoration: none;
    padding: 13px 36px;
    border: 1.5px solid #111;
    border-radius: 6px;
    transition: background 0.22s, color 0.22s;
  }
  .lp-collection__see-more-btn:hover {
    background: #111;
    color: #fff;
  }

  /* card stagger on scroll reveal */
  .lp-collection .lp-collection__grid .urbnmyth-product-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lp-collection.lp-revealed .lp-collection__grid .urbnmyth-product-card {
    opacity: 1;
    transform: translateY(0);
  }
  .lp-collection.lp-revealed .lp-collection__grid .urbnmyth-product-card:nth-child(1) {
    transition-delay: 80ms;
  }
  .lp-collection.lp-revealed .lp-collection__grid .urbnmyth-product-card:nth-child(2) {
    transition-delay: 170ms;
  }
  .lp-collection.lp-revealed .lp-collection__grid .urbnmyth-product-card:nth-child(3) {
    transition-delay: 260ms;
  }
  .lp-collection.lp-revealed .lp-collection__grid .urbnmyth-product-card:nth-child(4) {
    transition-delay: 350ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-collection .lp-collection__grid .urbnmyth-product-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ── Community ── */
  .lp-community {
    position: relative;
    overflow: hidden;
  }
  .lp-community__bg {
    width: 100%;
    line-height: 0;
  }
  .lp-community__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lp-community__fog-left {
    display: none;
  }
  /* dark overlay on the right half */
  .lp-community__dark-right {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 50%;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 100%);
    z-index: 1;
  }

  /* two-column layout overlaid on the image */
  .lp-community__layout {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: 0 48px;
    align-items: center;
  }
  .lp-community__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .lp-community__right {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-left: 140px;
  }

  /* Coming Soon text — centered over jacket */
  .lp-community__cs-eyebrow {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 10px;
  }
  .lp-community__cs-heading {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 28px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* WhatsApp content on right */
  .lp-community__content {
    position: relative;
    z-index: 2;
    text-align: left;
    color: #fff;
    padding: 0;
    max-width: 480px;
  }
  .lp-community__eyebrow {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 18px;
  }
  .lp-community__heading {
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 36px;
    white-space: nowrap;
  }
  .lp-community__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 36px;
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    border-radius: 6px;
    font-family: 'CoolveticaRg', sans-serif !important;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .lp-community__btn:hover {
    background: #fff;
    color: #111;
    border-color: #fff;
  }
  .lp-community__btn-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  /* ── Footer Image ── */
  .lp-footer-img {
    overflow: hidden;
    line-height: 0;
  }
  .lp-footer-img__img {
    width: 100%;
    height: auto;
    display: block;
    transform: scale(1.04);
    transition: transform 8s ease-in-out;
  }
  .lp-footer-img.lp-revealed .lp-footer-img__img {
    transform: scale(1);
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .lp-collection {
      padding: 36px 0;
    }
    .lp-collection__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    /* Community mobile: content anchored bottom-center, over darker gradient */
    .lp-community__layout {
      flex-direction: column;
      padding: 24px 24px 44px;
      gap: 0;
      align-items: center;
      justify-content: flex-end;
    }
    .lp-community__left {
      display: none;
    }
    .lp-community__right {
      flex: initial;
      padding-left: 0;
      justify-content: center;
      width: 100%;
    }
    .lp-community__content {
      max-width: 100%;
      width: 100%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .lp-community__cs-heading,
    .lp-community__heading {
      white-space: normal;
      font-size: clamp(2rem, 8.4vw, 3rem);
      letter-spacing: 0.04em;
      margin: 0 0 22px;
      text-align: center;
    }
    .lp-community__heading {
      margin-bottom: 28px;
    }
    .lp-community__fog-left {
      display: none;
    }
    .lp-community__dark-right {
      left: 0;
      top: 40%;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 60%, rgba(0, 0, 0, 0.75) 100%);
    }

    /* ── Scroll-linked letter reveal ── */
    .lp-letter-mask {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      line-height: 1.05;
      padding-bottom: 0.08em;
    }
    .lp-letter {
      display: inline-block;
      transform: translateY(110%);
      opacity: 0;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease-out;
      will-change: transform, opacity;
    }
    .lp-letter.is-in {
      transform: translateY(0);
      opacity: 1;
    }
    .lp-word {
      display: inline-block;
    }
    .lp-space {
      display: inline-block;
      width: 0.28em;
    }

    /* Staggered fade-up for eyebrows and button */
    .lp-fade-up {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform, opacity;
    }
    .lp-fade-up.is-in {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 580px) {
    .lp-container {
      padding: 0 16px;
    }
    .lp-collection {
      padding: 28px 0;
    }
    .lp-collection__grid {
      gap: 10px;
    }
    .lp-community__layout {
      padding: 44px 20px;
      gap: 36px;
    }
  }
</style>

<!--
  ═══════════════════════════════════════════════════
       JAVASCRIPT
  ═══════════════════════════════════════════════════
-->
<script>
  /* ── Hero Video: play after loading screen dismisses ── */
  (function () {
    var video = document.getElementById('lp-hero-video');
    if (!video) return;

    function playVideo() {
      video.play().catch(function () {});
    }

    if (window.lsDone) {
      playVideo();
    } else {
      window.addEventListener('ls:done', playVideo, { once: true });
      setTimeout(playVideo, 8000);
    }
  })();

  /* ── Scroll Reveal ── */
  (function () {
    var els = document.querySelectorAll('.lp-reveal');
    if (!els.length) return;

    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) {
        el.classList.add('lp-revealed');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('lp-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    els.forEach(function (el) {
      observer.observe(el);
    });
  })();

  /* ── Community: mobile scroll-linked letter reveal ── */
  (function () {
    var section = document.getElementById('lp-community');
    if (!section) return;
    if (window.matchMedia('(min-width: 901px)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Split target headings into per-letter masked spans */
    section.querySelectorAll('[data-lp-split]').forEach(function (el) {
      var words = el.textContent.trim().split(/\s+/);
      var html = words
        .map(function (word, wi) {
          var letters = word
            .split('')
            .map(function (ch) {
              return '<span class="lp-letter-mask"><span class="lp-letter">' + ch + '</span></span>';
            })
            .join('');
          return (
            '<span class="lp-word">' +
            letters +
            '</span>' +
            (wi < words.length - 1 ? '<span class="lp-space"></span>' : '')
          );
        })
        .join('');
      el.innerHTML = html;
    });

    var letters = Array.prototype.slice.call(section.querySelectorAll('.lp-letter'));
    var fades = Array.prototype.slice.call(section.querySelectorAll('.lp-fade-up'));
    var N = letters.length;
    var M = fades.length;
    if (!N && !M) return;

    var ticking = false;

    function apply() {
      ticking = false;
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;

      /* Progress: 0 when section top is at 90% of viewport, 1 when 70% scrolled through */
      var enter = vh * 0.9;
      var finish = -rect.height * 0.15;
      var range = enter - finish;
      var p = (enter - rect.top) / range;
      if (p < 0) p = 0;
      if (p > 1) p = 1;

      /* Letters ride the scroll — reveal count = progress * (N + padding) */
      var revealCount = Math.floor(p * (N + 10));
      for (var i = 0; i < N; i++) {
        var want = i < revealCount;
        if (letters[i]._on !== want) {
          letters[i].classList.toggle('is-in', want);
          letters[i]._on = want;
        }
      }

      /* Eyebrows + button — staggered thresholds across scroll range */
      for (var j = 0; j < M; j++) {
        var t = 0.12 + (j / Math.max(M - 1, 1)) * 0.55;
        var showFade = p >= t;
        if (fades[j]._on !== showFade) {
          fades[j].classList.toggle('is-in', showFade);
          fades[j]._on = showFade;
        }
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(apply);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    apply();
  })();

  /* ── Product Card Interactions ── */
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.lp-collection .urbnmyth-product-image').forEach(function (wrap) {
      var imgs = (wrap.dataset.images || '').split('||').filter(Boolean);
      if (imgs.length < 2) return;
      var primary = wrap.querySelector('.urbnmyth-img-primary');
      var secondary = wrap.querySelector('.urbnmyth-img-secondary');
      if (!primary || !secondary) return;
      imgs.forEach(function (src) {
        new Image().src = src;
      });
      wrap.addEventListener('mouseenter', function () {
        primary.style.opacity = '0';
        secondary.style.opacity = '1';
      });
      wrap.addEventListener('mouseleave', function () {
        primary.style.opacity = '1';
        secondary.style.opacity = '0';
      });
    });

    try {
      var wl = JSON.parse(localStorage.getItem('urbnmyth_wishlist') || '[]');
      wl.forEach(function (id) {
        document
          .querySelectorAll('.lp-collection .urbnmyth-wishlist-btn[data-product-id="' + id + '"]')
          .forEach(function (btn) {
            btn.classList.add('urbnmyth-wishlisted');
          });
      });
    } catch (e) {}
  });

  function urbnmythSelectSize(event, btn) {
    event.preventDefault();
    event.stopPropagation();
    var container = btn.closest('.urbnmyth-sizes');
    if (container)
      container.querySelectorAll('.urbnmyth-size-chip').forEach(function (c) {
        c.classList.remove('urbnmyth-size-selected');
      });
    btn.classList.add('urbnmyth-size-selected');
    var card = btn.closest('.urbnmyth-product-card');
    if (card && btn.dataset.variantId) {
      var addBtn = card.querySelector('.urbnmyth-hover-add-btn');
      if (addBtn) addBtn.setAttribute('onclick', "urbnmythQuickAddToCart(event,'" + btn.dataset.variantId + "',this)");
    }
  }

  function urbnmythQuickAddToCart(event, variantId, button) {
    event.preventDefault();
    event.stopPropagation();
    var orig = button.innerHTML;
    button.innerHTML = 'Adding...';
    button.disabled = true;
    var fd = new FormData();
    fd.append('id', variantId);
    fd.append('quantity', 1);
    fetch('/cart/add.js', { method: 'POST', body: fd })
      .then(function (r) {
        return r.json();
      })
      .then(function () {
        button.innerHTML = 'Added!';
        setTimeout(function () {
          window.location.href = '/cart';
        }, 600);
      })
      .catch(function () {
        button.innerHTML = 'Error — Try Again';
        button.style.background = '#dc3545';
        button.style.color = '#fff';
        setTimeout(function () {
          button.innerHTML = orig;
          button.disabled = false;
          button.style.background = '';
          button.style.color = '';
        }, 2000);
      });
  }

  function urbnmythManualCycle(event, btn) {
    event.preventDefault();
    event.stopPropagation();
    var wrap = btn.closest('.urbnmyth-product-image');
    if (!wrap) return;
    var imgs = (wrap.dataset.images || '').split('||').filter(Boolean);
    if (imgs.length < 2) return;
    var primary = wrap.querySelector('.urbnmyth-img-primary');
    var secondary = wrap.querySelector('.urbnmyth-img-secondary');
    if (!primary || !secondary) return;
    var idx = (parseInt(wrap.dataset.manualIndex || '1', 10) + 1) % imgs.length;
    wrap.dataset.manualIndex = idx;
    secondary.src = imgs[idx];
    primary.style.opacity = '0';
    secondary.style.opacity = '1';
  }

  function urbnmythQuickView(event, url) {
    event.preventDefault();
    event.stopPropagation();
    window.open(url + '?quickview=1', '_blank', 'noopener');
  }

  function urbnmythToggleWishlist(event, productId, btn) {
    event.preventDefault();
    event.stopPropagation();
    try {
      var wl = JSON.parse(localStorage.getItem('urbnmyth_wishlist') || '[]');
      var idx = wl.indexOf(String(productId));
      if (idx === -1) {
        wl.push(String(productId));
        btn.classList.add('urbnmyth-wishlisted');
      } else {
        wl.splice(idx, 1);
        btn.classList.remove('urbnmyth-wishlisted');
      }
      localStorage.setItem('urbnmyth_wishlist', JSON.stringify(wl));
    } catch (e) {}
  }
</script>

