    } else {
      termsConditionsExpandedSection = index;
    }

    // Update all sections
    document.querySelectorAll('.terms-conditions-section-content').forEach((content, i) => {
      content.style.display = i === termsConditionsExpandedSection ? 'block' : 'none';
    });

    document.querySelectorAll('.terms-conditions-section-arrow').forEach((arrow, i) => {
      arrow.textContent = i === termsConditionsExpandedSection ? '▲' : '▼';
    });
  }
</script>

