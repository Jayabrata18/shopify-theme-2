<script>
  let privacyPolicyExpandedSection = null;

  function privacyPolicyToggleSection(index) {
    if (privacyPolicyExpandedSection === index) {
      privacyPolicyExpandedSection = null;
    } else {
      privacyPolicyExpandedSection = index;
    }

    // Update all sections
    document.querySelectorAll('.privacy-policy-section-content').forEach((content, i) => {
      content.style.display = i === privacyPolicyExpandedSection ? 'block' : 'none';
    });

    document.querySelectorAll('.privacy-policy-section-arrow').forEach((arrow, i) => {
      arrow.textContent = i === privacyPolicyExpandedSection ? '▲' : '▼';
    });
  }
</script>

