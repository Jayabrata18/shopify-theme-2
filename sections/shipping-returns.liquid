<script>
  document.addEventListener('DOMContentLoaded', function () {
    let shippingReturnsActiveTab = 'shipping';

    function shippingReturnsSetActiveTab(tab) {
      shippingReturnsActiveTab = tab;

      // Update tab buttons
      document.querySelectorAll('.shipping-returns-tab').forEach((button) => {
        if (button.dataset.tab === tab) {
          button.className = 'shipping-returns-tab shipping-returns-tab-active';
        } else {
          button.className = 'shipping-returns-tab shipping-returns-tab-inactive';
        }
      });

      // Update tab content
      document.querySelectorAll('.shipping-returns-tab-content').forEach((content) => {
        content.style.display = content.id === `shipping-returns-${tab}` ? 'block' : 'none';
      });
    }

    // Make function globally available
    window.shippingReturnsSetActiveTab = shippingReturnsSetActiveTab;
  });
</script>

