{% comment %}
  Snippet: card-product-urbnmyth.liquid
  Usage:   {% render 'card-product-urbnmyth', product: product %}
  Expects: product — a Shopify product object
{% endcomment %}

{% assign image_urls = '' %}
{% for image in product.images limit: 5 %}
  {% assign img_url = image | image_url: width: 800 %}
  {% assign image_urls = image_urls | append: img_url | append: '||' %}
{% endfor %}

{% if product.images.size > 1 %}
  {% assign secondary_img_src = product.images[1] | image_url: width: 800 %}
{% else %}
  {% assign secondary_img_src = '' %}
{% endif %}

<div class="urbnmyth-product-card">

  <!-- Product Image -->
  <a href="{{ product.url }}"
     class="urbnmyth-product-image"
     data-images="{{ image_urls }}">

    {% if product.featured_image %}
      <img class="urbnmyth-img-primary"
           src="{{ product.featured_image | image_url: width: 800 }}"
           alt="{{ product.title }}"
           width="800"
           height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
           loading="lazy">
      {% if secondary_img_src != '' %}
      <img class="urbnmyth-img-secondary"
           src="{{ secondary_img_src }}"
           alt="{{ product.title }}"
           width="800"
           height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
           loading="lazy"
           aria-hidden="true">
      {% endif %}
    {% else %}
      <div class="urbnmyth-product-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    {% endif %}

    <!-- Add To Cart bar — slides up from bottom on hover -->
    <div class="urbnmyth-hover-add">
      <button class="urbnmyth-hover-add-btn"
              onclick="urbnmythQuickAddToCart(event, '{{ product.selected_or_first_available_variant.id }}', this)"
              {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}
          + Add To Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>
    </div>

  </a>

  <!-- Product Info: name → price → sizes -->
  <div class="urbnmyth-product-info">

    <a href="{{ product.url }}" class="urbnmyth-product-title">
      {{ product.title }}
    </a>

    <div class="urbnmyth-product-price">
      {% if product.compare_at_price > product.price %}
        <span class="urbnmyth-price-sale">{{ product.price | money }}</span>
        <span class="urbnmyth-price-compare">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span class="urbnmyth-price-regular">{{ product.price | money }}</span>
      {% endif %}
    </div>

    <!-- Sizes: clickable square chips -->
    {% assign size_option_index = nil %}
    {% for option in product.options %}
      {% if option == 'Size' or option == 'size' or option == 'SIZE' %}
        {% assign size_option_index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    {% if size_option_index != nil %}
      <div class="urbnmyth-sizes" data-product-id="{{ product.id }}">
        {% assign shown_sizes = '' %}
        {% for variant in product.variants %}
          {% if variant.available %}
            {% assign size_val = variant.options[size_option_index] %}
            {% unless shown_sizes contains size_val %}
              <button
                class="urbnmyth-size-chip"
                data-variant-id="{{ variant.id }}"
                data-size="{{ size_val }}"
                onclick="urbnmythSelectSize(event, this)"
              >{{ size_val }}</button>
              {% assign shown_sizes = shown_sizes | append: size_val | append: ',' %}
            {% endunless %}
          {% endif %}
        {% endfor %}
        {% if shown_sizes == '' %}
          <span class="urbnmyth-size-chip urbnmyth-size-sold">SOLD OUT</span>
        {% endif %}
      </div>
    {% endif %}

    {% assign color_option_index = nil %}
    {% for option in product.options %}
      {% if option == 'Color' or option == 'Colour' or option == 'color' or option == 'colour' %}
        {% assign color_option_index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    {% if color_option_index != nil %}
      <div class="urbnmyth-color-swatches">
        {% assign shown_colors = '' %}
        {% for variant in product.variants %}
          {% assign color_val = variant.options[color_option_index] %}
          {% unless shown_colors contains color_val %}
            <span
              class="urbnmyth-color-dot"
              title="{{ color_val }}"
              style="background: {{ color_val | downcase | replace: ' ', '' }};"
            ></span>
            {% assign shown_colors = shown_colors | append: color_val | append: ',' %}
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>
